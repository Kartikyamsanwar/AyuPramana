# AyuPramana — copy this file to `.env` and fill in the blanks.
# Never commit `.env`. Every setting below has a safe default.

# ---------------------------------------------------------------------------
# LLM provider: groq | anthropic | ollama | none
#   groq      — Groq cloud API (default). Key from https://console.groq.com
#   anthropic — Anthropic Claude API
#   ollama    — local Ollama server (offline fallback)
#   none      — no LLM: the assistant shows the retrieved provisions verbatim
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Main model: answers, citation verification, translation
GROQ_MODEL=openai/gpt-oss-120b
# Fast model: routing / classification
GROQ_FAST_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FAST_MODEL=

# low | medium | high — only sent to reasoning models (e.g. gpt-oss)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Embeddings and retrieval
# BAAI/bge-m3 gives the best multilingual quality but needs ~2-3 GB RAM.
# On laptops with 8 GB RAM or less use: intfloat/multilingual-e5-small
# Changing the model? Run `python scripts/ingest.py --all` again to re-embed.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Model download stuck at 0 bytes? Set to true (uses plain HTTPS instead of Hugging Face Xet)
HF_DISABLE_XET=false

# Cross-encoder reranker (improves ranking, costs RAM and latency)
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=30
# Cosine similarity of an unrelated / a clearly relevant passage, used to turn similarity into
# a 0-1 relevance for the confidence score. Leave blank for model defaults; tune after running eval.
SIMILARITY_FLOOR=
SIMILARITY_CEILING=

# Chunking (approximate tokens)
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=60

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
# Answers scoring below this confidence (0-1) are withheld (abstention)
CONFIDENCE_THRESHOLD=0.55
# Ask the LLM to check every sentence of a draft against its cited source
CITATION_VERIFICATION=true

# ---------------------------------------------------------------------------
# Translation (Bhashini is used when all three values are set; otherwise the LLM translates)
# Get credentials from the Bhashini (ULCA) dashboard.
# ---------------------------------------------------------------------------
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ---------------------------------------------------------------------------
# Storage (relative paths are resolved from the repository root)
# ---------------------------------------------------------------------------
DATA_DIR=data
STORAGE_DIR=storage

# ---------------------------------------------------------------------------
# Privacy and admin
# ---------------------------------------------------------------------------
# Enables the Audit/Admin page and /api/admin/* (no auth — prototype only!)
ADMIN_MODE=false
# Store PII-scrubbed queries for audit
LOG_QUERIES=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend feature flags (read by Vite at build time)
# ---------------------------------------------------------------------------
# Browser voice input (Web Speech API) — stretch goal
VITE_VOICE_INPUT=false
